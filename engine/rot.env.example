# =============================================================================
# rot.env -- RoT MoE configuration.
#
# GENERATED FROM hooks/rot-voice.dtd -- DO NOT EDIT BY HAND.
#   regenerate:  bash checker/env-wiring.sh --emit > engine/rot.env.example
#   verified by: bash checker/env-wiring.sh   (W2 fails if this file drifts)
#
# HOW TO USE IT. Copy, then uncomment only what you want to change:
#   per project : <project>/.rot-moe/rot.env
#   per operator: $XDG_CONFIG_HOME/rot-moe/rot.env   (~/.config/rot-moe/rot.env)
#   explicit    : export ROTMOE_ENV=/path/to/rot.env
#
# Every line here is COMMENTED OUT on purpose: copying this file verbatim
# changes nothing. W5 asserts that, so the shipped default stays inert.
#
# THREE LAWS the loader enforces (hooks/rot-env.sh:21-35):
#   1. NO EXPANSION. The value is data. $(rm -rf ~) exports as literal text.
#   2. DECLARED-ONLY. A key not declared below does not exist to the parser,
#      so a rot.env can never reach PATH, LD_PRELOAD or PS1.
#   3. UNSET-ONLY. A live export outranks every file; the first file wins.
#
# Works identically on macOS, Linux and Windows: the POSIX loader
# (hooks/rot-env.sh) and the PowerShell loader (hooks/rot-env.ps1) read
# THIS ONE FILE FORMAT. W7 asserts both arms agree on it.
# 34 keys declared.
# =============================================================================

# ROTMOE_ENV
#   type: path
#   an extra env file read first; never settable from a file
#   REFUSED FROM A FILE -- export it in the shell instead.
#   export ROTMOE_ENV=...

# ROTMOE_VOICE
#   type: 0 or 1
#   0 silences the voice block; default on
#ROTMOE_VOICE=

# ROTMOE_GATE
#   type: 0 or 1
#   0 disarms the voice gate; default on
#ROTMOE_GATE=

# ROTMOE_MODEL
#   type: model name
#   names the convener on CONVERGENT instead of reading settings
#ROTMOE_MODEL=

# ROTMOE_DEBUG_LOG
#   type: path or 0
#   central JSONL sink for route and gauge records; hook mode defaults to a per-session file under the state dir, 0 disables
#ROTMOE_DEBUG_LOG=

# ROTMOE_DEBUG_LOG_MAX
#   type: integer
#   line cap on that sink; default 5000
#ROTMOE_DEBUG_LOG_MAX=

# ROTMOE_DEBUG_LOCAL
#   type: 0 or 1
#   forces or forbids the per-project .rot-moe sink
#ROTMOE_DEBUG_LOCAL=

# ROTMOE_DEBUG_SRC
#   type: test cli hook
#   declares record provenance; a declaration outranks inference
#ROTMOE_DEBUG_SRC=

# ROTMOE_TOKEN_PCT
#   type: integer 0-100
#   token budget remaining; below 20 arms Soleil and narrows Chroma
#ROTMOE_TOKEN_PCT=

# ROTMOE_LEAN_WORKSPACE
#   type: path
#   which Lean workspace to build and remind about
#ROTMOE_LEAN_WORKSPACE=

# ROTMOE_WATCH_REPO
#   type: path
#   which repository the reminder scans for proof-shaped changes
#ROTMOE_WATCH_REPO=

# ROTMOE_STATE_DIR
#   type: path
#   where throttle stamps and the voice summons live
#ROTMOE_STATE_DIR=

# ROTMOE_PROOF_STALE_MIN
#   type: minutes
#   staleness threshold before the reminder speaks; default 45
#ROTMOE_PROOF_STALE_MIN=

# ROTMOE_DEBT_EXT
#   type: extension list
#   which source extensions count as proof-shaped
#ROTMOE_DEBT_EXT=

# ROTMOE_DEBT_PATTERN
#   type: regex
#   overrides the proof-shaped-code pattern
#ROTMOE_DEBT_PATTERN=

# ROTMOE_LEAN_VERIFY
#   type: 0 or 1
#   0 disables the on-edit lake build of a touched module
#ROTMOE_LEAN_VERIFY=

# ROTMOE_LEAN_VERIFY_SECS
#   type: seconds
#   timeout for that build; default 300
#ROTMOE_LEAN_VERIFY_SECS=

# ROTMOE_THROTTLE_PROMPT
#   type: minutes
#   reminder throttle on UserPromptSubmit; default 0
#ROTMOE_THROTTLE_PROMPT=

# ROTMOE_THROTTLE_PRE
#   type: minutes
#   reminder throttle on PreToolUse; default 7
#ROTMOE_THROTTLE_PRE=

# ROTMOE_THROTTLE_POST
#   type: minutes
#   reminder throttle elsewhere; default 5
#ROTMOE_THROTTLE_POST=

# ROTMOE_GOAL_FILE
#   type: path
#   a goal file whose open alarm rows the reminder counts
#ROTMOE_GOAL_FILE=

# ROTMOE_CWD
#   type: path
#   overrides the directory workspace discovery walks up from
#ROTMOE_CWD=

# ROTMOE_HOME
#   type: path
#   where the RoT-MoE tree lives, for the rot profile; never settable from a file -- it decides which code runs
#   REFUSED FROM A FILE -- export it in the shell instead.
#   export ROTMOE_HOME=...

# ROTMOE_DEBUG_PAYLOAD
#   type: 1 or unset
#   hook payload KEY survey (key names only, never a value) into a per-session state-dir sink -- the measuring instrument a new payload-field reader must run first
#ROTMOE_DEBUG_PAYLOAD=

# ROTMOE_ANIMUS
#   type: 1 or unset
#   arms the paired observer's worker-side ear: consume ONE queued lens remark per PostToolUse from animus-queue.<session> in the state dir (written by hooks/animus-observe.sh); unset = the queue is never read
#ROTMOE_ANIMUS=

# ROTMOE_ANIMUS_ANOMALY_N
#   type: count
#   observer: same-shape anomaly records (the sentinel's own log line) that summon AntiVenom's recurrence remark; default 2 -- a BASE, divided by AntiVenom's measured share of the gauge, floored at 2 so the remark's own words stay true
#ROTMOE_ANIMUS_ANOMALY_N=

# ROTMOE_ANIMUS_COST_N
#   type: count
#   observer: consecutive tool events with strictly rising ms that summon Chroma's pricing remark; default 3 -- a BASE, divided by Chroma's measured share of the gauge
#ROTMOE_ANIMUS_COST_N=

# ROTMOE_ANIMUS_DITHER_N
#   type: count
#   observer: consecutive prompt events with no tool event between that summon Venom's decide-and-move remark; default 3 -- a BASE, divided by Venom's measured share of the gauge
#ROTMOE_ANIMUS_DITHER_N=

# ROTMOE_ANIMUS_BLOAT_N
#   type: count
#   observer: consecutive tool events whose action text grows every time (the chars field) that summon Soleil's compression remark; default 3 -- a BASE, divided by Soleil's measured share of the gauge
#ROTMOE_ANIMUS_BLOAT_N=

# ROTMOE_ANIMUS_LOOP_N
#   type: count
#   observer: recurrences of one lane+stem pair that summon Eidolon's self-similarity remark; default 4 -- a BASE, divided by Eidolon's measured share of the gauge
#ROTMOE_ANIMUS_LOOP_N=

# ROTMOE_ANIMUS_TEXT_N
#   type: count
#   observer: sink records without the task text's own lane before the text-vs-stream pair (Violet for EMPATHIC, Chroma for PREDICTIVE) may speak, once each per run; default 6 -- a BASE, divided by the speaking lens's measured share of the gauge; the watch arms itself on the prompt event the router already routed
#ROTMOE_ANIMUS_TEXT_N=

# ROTMOE_ANIMUS_STALL_SECS
#   type: seconds
#   observer: age of a PreToolUse with no Post behind it before Claude's stall remark -- the measurement that never returned; default 120 -- a BASE, divided by Claude's measured share of the gauge but never below 45s: a false stall is a lie told in a lens's own voice
#ROTMOE_ANIMUS_STALL_SECS=

# ROTMOE_ANIMUS_DISTILLATE
#   type: path
#   overrides the project distillate (default <project>/.rot-moe/animus-distillate.md, self-gitignoring like the project sink)
#ROTMOE_ANIMUS_DISTILLATE=

# ROTMOE_ANIMUS_DISTILLATE_GLOBAL
#   type: path
#   overrides the global distillate (default <state-dir>/animus-distillate.md)
#ROTMOE_ANIMUS_DISTILLATE_GLOBAL=
