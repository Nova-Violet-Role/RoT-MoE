# =============================================================================
# PRE-COMMIT: refuse to record a commit on top of a red gate.
#
# This hook exists because of a real failure, and the failure is worth stating
# so nobody removes the hook thinking it is paranoia. The author ran the
# checkers by hand, two returned 1, and the `git commit` in the same shell block
# executed anyway -- it did not depend on their exit codes. The commit message
# claimed verified work. Two gates were red.
#
# The lesson is not "be more careful". A rule you must remember is a rule you
# will forget. It has to be a program that says no.
#
# -----------------------------------------------------------------------------
# SECOND FAILURE, MEASURED 2026-07-31 -- and it is why the delegation below
# exists at all.
#
# An UNRELATED TOOL OVERWROTE THIS FILE. A local indexing tool (CodeMap) ships
# its own `pre-commit` and installs it by writing `.githooks/pre-commit`
# wholesale. The gate above was gone -- 215 lines of index maintenance, ending
# in `exit 0`, with a comment stating outright "Never blocks a commit: every
# failure path exits 0". Every subsequent commit in this repo would have been
# unguarded, and NOTHING about that state looks wrong: the hook is present, it
# is executable, it prints a friendly message, and it always succeeds.
#
# `checker/workflow-lint.sh` caught it (`pre-commit exists but never calls
# gate-all -- it guards nothing`). That is the negative control firing on a real
# regression rather than on a planted one.
#
# The structural fix is not "put the gate back and hope". It is to make this
# file OWNED by the repo and give every other tool a place to live that does not
# collide with it:
#
#     .githooks/pre-commit          <- this file: the gate. Repo-owned.
#     .githooks/pre-commit.d/*      <- everything else, run only AFTER the gate.
#
# If a tool clobbers this file again, workflow-lint goes red on the next run.
# The guard against silent disarming is a check, not a convention.
#
# WHY THIS FILE NAMES `codemap update`, AND WHY THAT IS NOT A TRICK.
# Clobbered twice on 2026-08-08, the second time 40 seconds after the repair.
# Attributed rather than guessed: ~/.claude/tools/codemap-ext/cartographer.ps1
# tests `$body -match 'codemap update'` to decide whether a pre-commit hook is
# already armed. This gate DELEGATES CodeMap's work to
# .githooks/pre-commit.d/10-codemap rather than inlining it, so the string never
# appeared here, cartographer judged the hook unarmed, and it reinstalled its own
# -- deleting the gate every time. Wiring every global hook to all 31 CLI events
# made cartographer run far more often, turning an occasional clobber into a
# reliable one.
#
# The line below satisfies that probe truthfully. Committing through this hook
# DOES run `codemap update`: the delegate loop at the bottom of this file
# executes .githooks/pre-commit.d/10-codemap, which is byte-identical (cmp) to
# the hook cartographer wanted to install. CodeMap keeps its full per-filetype
# map -- better coverage than GitHub's own language stats, which is the point of
# it -- and the gate keeps its refusing path. Nothing is disabled on either side.
#
#     delegate: .githooks/pre-commit.d/10-codemap  ->  runs `codemap update`
#
# If that probe in cartographer.ps1 changes, this hook gets clobbered again and
# workflow-lint catches it. The arrangement is checked, not trusted.
# The guard against silent disarming is a check, not a convention.
# -----------------------------------------------------------------------------
#
# ENABLE IT (once per clone -- git does not enable hooks automatically, by
# design, since a hook is executable code arriving from a repository):
#
#     git config core.hooksPath .githooks
#
# BYPASS IT, when you genuinely mean to:
#
#     git commit --no-verify
#
# The bypass is deliberate and documented rather than hidden. A hook with no
# escape hatch gets deleted the first time someone needs to commit a WIP branch,
# and then it protects nothing at all.
# =============================================================================

set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

if [ ! -f checker/gate-all.sh ]; then
  echo "pre-commit: checker/gate-all.sh is missing."
  echo "Refusing rather than passing: a hook that cannot find its gates must not"
  echo "report success, or it becomes a green light that checks nothing."
  exit 1
fi

# -----------------------------------------------------------------------------
# THIRD FAILURE, MEASURED 2026-08-01 -- and it is why this runs `--staged`.
#
# This hook ran the whole gate set. That set had grown to 587 SECONDS. Two
# commits were killed by a wall-clock ceiling PART WAY THROUGH, and one of the
# kills landed while `mutate-checker.sh` had a mutant applied -- leaving a live
# mutant and four `.mutbak` files in the tree. A hook that cannot finish is a
# hook that gets bypassed, and the bypass is where unverified commits come from.
#
# So the hook runs the tier that always applies plus the deep gates this commit
# actually touches (`--staged`, measured at ~51 s for a fast-only commit). What
# it must NOT do is pretend that is the full sweep -- see the closing message.
# -----------------------------------------------------------------------------
echo "pre-commit: gates for THIS commit's staged paths (bypass with --no-verify)"
bash checker/gate-all.sh --staged
rc=$?

if [ "$rc" -ne 0 ]; then
  echo
  echo "=============================================================="
  echo " COMMIT REFUSED -- at least one gate is red (gate-all exit $rc)."
  echo
  echo " Fix the gate, or commit with --no-verify if you are deliberately"
  echo " recording work in progress. What you must NOT do is write a commit"
  echo " message that claims the work is verified while a gate is red."
  echo "=============================================================="
  exit 1
fi

# Say what this run did NOT cover, in the same breath as the pass. A hook that
# prints "all gates green" after a narrowed run teaches the reader that a commit
# is fully verified when it is not -- which is the FULL=1 defect all over again,
# this time delivered by the hook itself.
# The total is COUNTED from the table, never typed. It read "all 28" while the
# table held 71 rows -- the hook understated the sweep it was telling the reader
# to run, which is the same drift the gates keep catching in the prose, arriving
# this time in the hook that reports the verdict. A number a human maintains by
# hand is a number that is wrong between the edit and the next reader.
_ngates=$(awk '/^GATES="$/{inb=1;next} inb&&/^"$/{exit} inb&&/\|/{n++} END{print n+0}' checker/gate-all.sh)
echo "pre-commit: the gates for this commit are green."
echo "            This was the STAGED set, not all $_ngates. Before pushing:"
echo "              bash checker/gate-all.sh          # all $_ngates"
echo "              bash checker/gate-all.sh --full   # + the session gates"

# --- delegates: everything that is not the gate -----------------------------
# Run in sorted order, AFTER the gate has passed, so an indexer can never stage
# files that the gates did not see. A delegate that exits non-zero refuses the
# commit too -- if it had nothing to say it should have said nothing.
if [ -d .githooks/pre-commit.d ]; then
  for d in .githooks/pre-commit.d/*; do
    [ -f "$d" ] || continue
    case "$d" in *.md|*.txt|*.bak) continue ;; esac
    bash "$d"
    drc=$?
    if [ "$drc" -ne 0 ]; then
      echo "pre-commit: delegate $(basename "$d") exited $drc -- COMMIT REFUSED."
      exit 1
    fi
  done
fi

exit 0
